#运行环境
NODE_ENV = 'development'

# devServer port
VITE_APP_PORT=8000

# mock 是否开启 true|false ， development环境有效
VITE_APP_MOCK = true

#api接口域名
VITE_APP_APIHOST_MOCK = /api
VITE_APP_APISUFFIX = api/v1
VITE_APP_APIHOST = http://127.0.0.1:8085/api/v1
# VITE_APP_APIHOST = http://192.168.0.112:8085/api/v1
